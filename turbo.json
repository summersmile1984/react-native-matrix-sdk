{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "yarn.lock",
    "*.podspec",
    "src/**",
    "cpp/**",
    "swift/**",
    "ios/**",
    "android/CMakeLists.txt",
    "android/src/**",
    "scripts/**"
  ],
  "pipeline": {
    "build:android": {
      "cache": false,
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "src/**",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "cache": false,
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "package.json",
        "src/**",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
